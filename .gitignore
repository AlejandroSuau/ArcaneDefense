# =============================================================================
# Unreal Engine 5.x
# =============================================================================

# Compiled project binaries
Binaries/

# Temporary files generated by Unreal Build Tool
Intermediate/

# Regenerable asset and shader cache
DerivedDataCache/

# Logs, autosaves, crashes, staged builds and local editor settings
Saved/

# Local packaged builds
LocalBuilds/
ArchivedBuilds/
StagedBuilds/

# Local Unreal automation output
AutomationTool/
Engine/Programs/AutomationTool/Saved/

# Unreal frontend and build tool temporary files
*.uatbuildrecord

# Local developer-specific assets
Content/Developers/


# =============================================================================
# Project plugins
# =============================================================================

# Compiled plugin binaries
Plugins/**/Binaries/

# Temporary plugin build files
Plugins/**/Intermediate/

# Plugin logs, autosaves and local settings
Plugins/**/Saved/

# Regenerable plugin cache
Plugins/**/DerivedDataCache/


# =============================================================================
# Visual Studio
# =============================================================================

# Visual Studio local workspace
.vs/

# Visual Studio workload configuration generated by Unreal
.vsconfig

# Generated solution files
*.sln
*.slnx

# Generated Visual Studio project files
*.vcxproj
*.vcxproj.filters
*.vcxproj.user

# Visual Studio user-specific files
*.suo
*.user
*.userosscache

# Visual Studio database files
*.sdf
*.opensdf
*.VC.db
*.VC.opendb

# IntelliSense and compilation files
*.obj
*.pch
*.ipch
*.tlog

# Debug symbol files
*.pdb

# Visual Studio temporary files
*.lastbuildstate


# =============================================================================
# JetBrains Rider
# =============================================================================

# Rider project configuration
.idea/
.idea.*/

# Rider-generated solution metadata
*.sln.iml

# Rider user-specific settings
*.sln.DotSettings.user
*.DotSettings.user


# =============================================================================
# Visual Studio Code
# =============================================================================

# Visual Studio Code workspace settings
.vscode/

# Generated workspace files
*.code-workspace


# =============================================================================
# Clang tooling
# =============================================================================

# Generated compilation database
compile_commands.json

# Clangd local cache
.clangd/
.cache/clangd/


# =============================================================================
# Xcode
# =============================================================================

# Generated Xcode projects and workspaces
*.xcodeproj/
*.xcworkspace/

# Xcode user-specific data
xcuserdata/
*.xcuserstate

# Xcode build output
DerivedData/


# =============================================================================
# Build and packaging output
# =============================================================================

# Packaged Unreal Engine files
*.pak
*.ucas
*.utoc
*.sig

# Shader debugging output
ShaderDebugInfo/

# Lightmass and Swarm temporary data
SwarmCache/
SwarmIntermediate/


# =============================================================================
# Logs and temporary files
# =============================================================================

# Log files
*.log

# Temporary and backup files
*.tmp
*.temp
*.bak
*.old
*.orig

# Editor swap files
*.swp
*.swo

# Patch rejection files
*.rej


